{{!-- Handlebars module in express used to display dynamic content  --}}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Weather</title>
    <link rel="icon" href="/img/art.png">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <div class="main-content">
        {{!-- Partial header used in many pages --}}
        {{>header}}

        <p>This website shows your weather.</p>

        {{!-- Search form to get input from user --}}
        <form>
            <input placeholder="Location">
            <button>Search</button>
        </form>

        <p id="msg-one"></p>
        <p id="msg-two"></p>
    </div>

   

    {{>footer}}

    <script src="/js/app.js"></script>
</body>
</html>